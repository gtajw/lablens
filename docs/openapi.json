  "components": {
    "schemas": {
      "AnalysisRequest": {
        "properties": {
          "dataset_version_id": {
            "type": "string",
            "format": "uuid",
            "title": "Dataset Version Id"
          },
          "x_transform": {
            "$ref": "#/components/schemas/Transform"
          },
          "y_transform": {
            "$ref": "#/components/schemas/Transform",
            "default": {
              "kind": "identity",
              "input_role": "dependent"
            }
          },
          "model": {
            "$ref": "#/components/schemas/Model"
          },
          "student_claim": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Claim"
              },
              {
                "type": "null"
              }
            ]
          },
          "display_precision": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 3.0,
            "title": "Display Precision",
            "default": 6
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_version_id",
          "x_transform",
          "model"
        ],
        "title": "AnalysisRequest"
      },
      "Body_csv_dataset_internal_v1_projects__project_id__datasets_csv_post": {
        "properties": {
          "metadata": {
            "type": "string",
            "maxLength": 4096,
            "title": "Metadata"
          },
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "metadata",
          "file"
        ],
        "title": "Body_csv_dataset_internal_v1_projects__project_id__datasets_csv_post"
      },
      "Cell": {
        "properties": {
          "raw": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Raw"
          },
          "value": {
            "type": "number",
            "title": "Value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "raw",
          "value"
        ],
        "title": "Cell"
      },
      "Claim": {
        "properties": {
          "coefficient_key": {
            "type": "string",
            "enum": [
              "linear",
              "quadratic"
            ],
            "title": "Coefficient Key"
          },
          "unit_input": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Unit Input"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "coefficient_key",
          "unit_input"
        ],
        "title": "Claim"
      },
      "Column": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "independent",
              "dependent"
            ],
            "title": "Role"
          },
          "position": {
            "type": "integer",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Position"
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Name"
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Symbol"
          },
          "unit_input": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Unit Input"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
